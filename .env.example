# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (create a project, then add these values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HeyGen: keep the API key server-side only
HEYGEN_API_KEY=

# Pricing configuration. Never assume Avatar 6 rates; set after confirming your HeyGen account pricing.
USD_TO_INR=85
HEYGEN_AVATAR_III_USD_PER_MIN=0.99
HEYGEN_AVATAR_IV_USD_PER_MIN=2.31
HEYGEN_AVATAR_6_USD_PER_MIN=
HEYGEN_AVATAR_6_TURBO_USD_PER_MIN=

# Internal wallet configuration (admin-controlled)
CREDITS_PER_INR=1
CUSTOMER_MARGIN_MULTIPLIER=1
